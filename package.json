{
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "esbuild dist/static/client.js --minify --allow-overwrite --outfile=dist/static/client.js & esbuild dist/static/style.css --minify --allow-overwrite --outfile=dist/static/style.css",
    "preview": "npm run build && wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:preview": "npm run build && wrangler pages deploy dist --branch=preview"
  },
  "dependencies": {
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260530.1",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "@hono/vite-dev-server": "^0.26.0",
    "@types/node": "^25.9.1",
    "sharp": "^0.34.5",
    "vite": "^8.0.14",
    "wrangler": "^4.95.0"
  }
}
